# Use the built-in SQLite database — no PostgreSQL needed on any machine.
# (Set DB_BACKEND=postgres to use the PostgreSQL settings below instead.)
DB_BACKEND=sqlite

POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_DB=powerhouse_gym
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

SECRET_KEY=powerhouse_gym_secret_key_2024_ultra_secure
ALGORITHM=HS256
TOKEN_EXPIRE_HOURS=24